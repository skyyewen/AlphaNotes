# Browser API prefix. Keep empty for same-origin /api requests. Never put model keys here.
VITE_API_BASE_URL=

# Vite-only proxy. It is not included in the browser bundle.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Local demo connects to the backend; configure model keys on the backend only.
VITE_ENABLE_RESEARCH_API=true
