# Optional: copy to .env; the application also starts with defaults and no keys.
APP_NAME=workbench-backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]

# Local RAG runs inside this backend. Relative storage paths use the backend root.
# Local indexes are created on the first RAG operation.
RAG_DATA_DIR=data/rag
RESEARCH_DB_PATH=data/research/research.sqlite3
# Bundled synthetic demo data; relative paths use this backend directory.
STOCK_DAILY_PARQUET_PATH=../demo-data/market/daily.parquet
# Bundled demonstration Wiki; replace both paths when using your own data.
STRATEGY_WIKI_ROOT=../demo-data/strategy-wiki
RAG_RERANK_URL=https://api.siliconflow.cn/v1/rerank
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=

# Used only on explicit debug chat or research requests.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Run controls; no extra character budget is applied to tool results.
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MODEL_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TOTAL_TIMEOUT_SECONDS=180
